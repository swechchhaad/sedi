(* GENERATED by scripts/prv01_proverif.py -- do not edit by hand.
   SEDI-PRV-01 two-world unlinkability experiment: B_shared_attr_salt
   P8 but undisclosed attribute block salted per credential
   Flags: M1 M2 M3 M4 M5 M6 M7 M8 SHARED_ATTR_SALT
   world 0 (left):  one holder presents C1 to V1 and C2 to V2
   world 1 (right): H1 presents C1 to V1, H2 presents C2 to V2 *)

free c: channel.

fun h(bitstring): bitstring.
fun pk(bitstring): bitstring.
fun sign(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; verify(sign(m, k), m, pk(k)) = true.
reduc forall m: bitstring, k: bitstring; getmsg(sign(m, k)) = m.

const schema, over21, attrs, ixn, leaf, node, aid, pres, tel, iss,
      telquery, issuedto, std, anon: bitstring.

process
  new skI: bitstring;
  out(c, pk(skI));
  (* holder's real identity: only ever inside the salted attribute block,
     or handed over by a colluding issuer (E) *)
  new n1: bitstring; new n2r: bitstring;
  let n2 = choice[n1, n2r] in
  (* credential uuid: makes the SAID unique per copy under M1 *)
  new u1: bitstring; new u2: bitstring;
  (* salt of the undisclosed attribute block *)
  new a1: bitstring; new a2r: bitstring;
  let a2 = choice[a1, a2r] in
  (* Issuee AID key *)
  new e1: bitstring; new e2: bitstring;
  (* TEL registry id (ri) *)
  new r1: bitstring; new r2: bitstring;
  (* holder/sender AID: stable across key rotation unless M5, so it is
     independent of the signing key k *)
  new s1: bitstring; new s2: bitstring;
  (* presentation proof signing key *)
  new k1: bitstring; new k2: bitstring;
  (* disclosed attribute *)
  let d1 = over21 in let d2 = over21 in
  (* size/timing class *)
  let z1 = std in let z2 = std in
  (* transport address *)
  let t1 = anon in let t2 = anon in
  (* status-retrieval session *)
  let q1 = anon in let q2 = anon in

  (* ACDC: SAID is a digest over the credential content *)
  let pkI = pk(skI) in
  let ab1 = h((attrs, n1, a1)) in
  let ab2 = h((attrs, n2, a2)) in
  let said1 = h((pkI, schema, pk(e1), r1, d1, ab1, u1)) in
  let said2 = h((pkI, schema, pk(e2), r2, d2, ab2, u2)) in
  let cred1 = (said1, pkI, schema, pk(e1), r1, d1, ab1, u1) in
  let cred2 = (said2, pkI, schema, pk(e2), r2, d2, ab2, u2) in
  (* single credential, or individually anchored copies *)
  let anc1 = sign((ixn, said1), skI) in
  let anc2 = sign((ixn, said2), skI) in

  (* presentation i: verifier Vi (attacker) picks the challenge *)
  (
    ( in(c, nonce1: bitstring);
      let sid1 = h((aid, s1)) in
      let msg1 = (pres, cred1, anc1, sid1, pk(k1)) in
      out(c, (t1, z1, msg1, sign((nonce1, msg1), k1))) )
  | ( in(c, nonce2: bitstring);
      let sid2 = h((aid, s2)) in
      let msg2 = (pres, cred2, anc2, sid2, pk(k2)) in
      out(c, (t2, z2, msg2, sign((nonce2, msg2), k2))) )
  )
