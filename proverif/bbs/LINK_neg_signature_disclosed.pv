(* GENERATED by scripts/bbs_proverif.py -- do not edit by hand.
   SEDI joint (BBS + ZK) LINK_neg_signature_disclosed: negative: the BBS signature itself is shown
   Flags: SHOW_SIG
   world 0: holder 1 presents to V1 and V2; world 1: holder 1 to V1, holder 2 to V2.
   Verifiers AND the issuer are the attacker (issuer key + issuance records). *)

free c: channel.
free hv, sink, vlocal: channel [private].
const accepted, none: bitstring.

const icp, rot, ixn, ks, prf, req, getcred, issued, declined, norev, nods: bitstring.
const bbskey, accseal: bitstring.
const tt, ff, t21, t25, t30, e0, e1, ph0, ph1: bitstring.
const cpres, csched, status, fetchall, statusquery, vid, hep: bitstring.

fun h(bitstring): bitstring.
fun pk(bitstring): bitstring.
(* device / witness signatures (e.g. ECDSA in the secure element) *)
fun sign(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; verify(sign(m, k), m, pk(k)) = true.
reduc forall m: bitstring, k: bitstring; getmsg(sign(m, k)) = m.

(* hiding, binding commitment *)
fun com(bitstring, bitstring): bitstring.

(* BBS signature over a message vector; only the holder ever sees it *)
fun bbs(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; bbsver(bbs(m, k), m, pk(k)) = true.

(* accumulator non-membership witness: computable only for non-revoked
   handles, from the public whole-list update (private = attacker cannot
   compute it for a revoked handle) *)
fun nmw(bitstring, bitstring): bitstring [private].

(* zero-knowledge proofs: zk(secrets, publics, randomness). No destructor
   returns the secrets; verification checks the relation for given publics. *)
fun zkauth(bitstring, bitstring, bitstring): bitstring.
fun zkrev(bitstring, bitstring, bitstring): bitstring.

(* pi_auth: I know a BBS credential on (hid, a, rh) under ki, a witness
   attestation that kd is hid's device key at epoch e, and a signature by kd on (nonce, t, C),
   such that predicate t of a has value b, and C commits to rh. One rule
   per predicate in the bounded domain. *)
reduc
  forall hid, b1, b2, b3, rh, ki, kw, kd, e, n, rc, r: bitstring;
    vauth(zkauth((bbs((hid, (b1, b2, b3), rh), ki), sign((ks, hid, pk(kd), e), kw), sign((prf, n, t21, com(rh, rc)), kd), rh, rc),
          (pk(ki), pk(kw), e, n, t21, b1, com(rh, rc)), r),
          (pk(ki), pk(kw), e, n, t21, b1, com(rh, rc))) = true;
  forall hid, b1, b2, b3, rh, ki, kw, kd, e, n, rc, r: bitstring;
    vauth(zkauth((bbs((hid, (b1, b2, b3), rh), ki), sign((ks, hid, pk(kd), e), kw), sign((prf, n, t25, com(rh, rc)), kd), rh, rc),
          (pk(ki), pk(kw), e, n, t25, b2, com(rh, rc)), r),
          (pk(ki), pk(kw), e, n, t25, b2, com(rh, rc))) = true;
  forall hid, b1, b2, b3, rh, ki, kw, kd, e, n, rc, r: bitstring;
    vauth(zkauth((bbs((hid, (b1, b2, b3), rh), ki), sign((ks, hid, pk(kd), e), kw), sign((prf, n, t30, com(rh, rc)), kd), rh, rc),
          (pk(ki), pk(kw), e, n, t30, b3, com(rh, rc)), r),
          (pk(ki), pk(kw), e, n, t30, b3, com(rh, rc))) = true.

(* pi_rev: the rh committed in C is not revoked in accumulator value acc
   (the epoch constant, or a KEL-anchored value with ISSUER_KEL) *)
reduc forall rh, acc, n, rc, r: bitstring;
  vrev(zkrev((rh, nmw(rh, acc), rc), (acc, n, com(rh, rc)), r), (acc, n, com(rh, rc))) = true.


process
  new skI: bitstring; new skW: bitstring;
  out(c, (pk(skI), pk(skW), skI));
  new k10: bitstring; new k11: bitstring; new k12: bitstring; new rh1: bitstring;
  let hid1 = h((pk(k10), h(pk(k11)))) in
  let cred1 = bbs((hid1, (tt, ff, ff), rh1), skI) in
  let att10 = sign((ks, hid1, pk(k10), e0), skW) in
  let att11 = sign((ks, hid1, pk(k11), e1), skW) in
  let rot1 = (rot, hid1, pk(k11), h(pk(k12))) in
  out(c, ((icp, hid1, pk(k10), h(pk(k11))), att10));    (* public key-event log *)
  out(c, (issued, hid1, (tt, ff, ff), rh1));                    (* issuance record, to colluders *)
  new k20: bitstring; new k21: bitstring; new k22: bitstring; new rh2: bitstring;
  let hid2 = h((pk(k20), h(pk(k21)))) in
  let cred2 = bbs((hid2, (tt, tt, ff), rh2), skI) in
  let att20 = sign((ks, hid2, pk(k20), e0), skW) in
  let att21 = sign((ks, hid2, pk(k21), e1), skW) in
  let rot2 = (rot, hid2, pk(k21), h(pk(k22))) in
  out(c, ((icp, hid2, pk(k20), h(pk(k21))), att20));    (* public key-event log *)
  out(c, (issued, hid2, (tt, tt, ff), rh2));                    (* issuance record, to colluders *)
  let hidP = choice[hid1, hid2] in
  let credP = choice[cred1, cred2] in
  let rhP = choice[rh1, rh2] in
  let skP = choice[k10, k20] in
  let attP = choice[att10, att20] in
  ( ( in(c, n1: bitstring);
      new rc1: bitstring; new ra1: bitstring; new rb1: bitstring;
      let C1 = com(rh1, rc1) in
      out(c, (t21, tt, C1,
          zkauth((cred1, att10, sign((prf, n1, t21, C1), k10), rh1, rc1), (pk(skI), pk(skW), e0, n1, t21, tt, C1), ra1),
          zkrev((rh1, nmw(rh1, e0), rc1), (e0, n1, C1), rb1), cred1)) )
  | ( in(c, n2: bitstring);
      new rc2: bitstring; new ra2: bitstring; new rb2: bitstring;
      let C2 = com(rhP, rc2) in
      out(c, (t21, tt, C2,
          zkauth((credP, attP, sign((prf, n2, t21, C2), skP), rhP, rc2), (pk(skI), pk(skW), e0, n2, t21, tt, C2), ra2),
          zkrev((rhP, nmw(rhP, e0), rc2), (e0, n2, C2), rb2), credP)) ) )
