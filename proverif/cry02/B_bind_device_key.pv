(* GENERATED by scripts/cry02_proverif.py -- do not edit by hand.
   SEDI-CRY-02 B_bind_device_key: credential bound directly to the device public key (no KEL)
   Flags: BIND_KEY
   phase 0 = before migration, phase 1 = after migration.
   HW-NX: device keys are `new` names used only through sign(); they leave the
   device only through an explicit compromise branch. *)

free c: channel.
free pair, enroll, deliver, handover, srv: channel [private].

fun h(bitstring): bitstring.
fun pk(bitstring): bitstring.
fun sign(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; verify(sign(m, k), m, pk(k)) = true.
reduc forall m: bitstring, k: bitstring; getmsg(sign(m, k)) = m.

const s0, s1, icp, rot, pres, cred, schema: bitstring.

(* key event log held by an honest witness pool: aid, sn, current key, next digest *)
table kel(bitstring, bitstring, bitstring, bitstring).

event KeyGen(bitstring, bitstring).
event OldKey(bitstring, bitstring).
event NewKey(bitstring, bitstring).
event Issued(bitstring, bitstring).
event DeviceSigned(bitstring, bitstring, bitstring, bitstring).
event AcceptControl(bitstring, bitstring, bitstring, bitstring).
event AcceptCurrent(bitstring, bitstring, bitstring, bitstring).
event Rotated(bitstring, bitstring).
event Compromised(bitstring).
event Reveal(bitstring).
event OracleUsed(bitstring).
event ServerGotKey(bitstring).
event MigrationDone(bitstring).

query a, n, s, p: bitstring; event(AcceptControl(a, n, s, p)).  (* sanity_accept_pre: a verifier can accept proof of control before migration *)
query a, n, s, p: bitstring; inj-event(AcceptControl(a, n, s, p)) ==> inj-event(DeviceSigned(a, n, s, p)).  (* Q1a_control_pre: 1. holder control (before migration): acceptance => the holder device signed this challenge *)
query a, n, s, p: bitstring; event(AcceptCurrent(a, n, s, p)) && event(MigrationDone(a)) ==> event(DeviceSigned(a, n, s, p)).  (* Q1b_control_post: 1. holder control (after a completed migration) *)
query a, n, s, p: bitstring; event(AcceptControl(a, n, s, p)) ==> event(DeviceSigned(a, n, s, p)) || event(Compromised(p)).  (* Q1c_control_pre_or_compromise: 1. holder control before migration, except after compromise of that key *)
query a, n, s, p: bitstring; event(AcceptCurrent(a, n, s, p)) && event(MigrationDone(a)) ==> event(DeviceSigned(a, n, s, p)) || event(Compromised(p)).  (* Q1d_control_post_or_compromise: 1. holder control after migration, except after compromise of that key *)
query attacker(new sk0).  (* Q2a_secret_sk_old: 2. key secrecy: old/current device key *)
query attacker(new sk1).  (* Q2b_secret_sk_new: 2. key secrecy: new device / pre-rotated key *)
query k: bitstring; event(KeyGen(k, pk(k))) && attacker(k) ==> event(Reveal(pk(k))).  (* Q2c_secret_unless_reveal: 2. any holder key known to the attacker was explicitly revealed *)
query p: bitstring; event(ServerGotKey(p)).  (* Q3_no_server_copy: 3. no issuer/server ever receives a holder private key *)
query a, n, s, p: bitstring; event(AcceptCurrent(a, n, s, p)) && event(NewKey(a, p)) ==> false.  (* Q4a_migrated_accept: 4. after migration, the credential is accepted under the NEW key *)
query a, n, s, p: bitstring; event(AcceptCurrent(a, n, s, p)) ==> event(Issued(s, a)).  (* Q4b_no_reissue: 4. ...for the credential issued once, before migration (no new Issued event) *)
query a, n, s, p: bitstring; event(AcceptCurrent(a, n, s, p)) && event(OldKey(a, p)) && event(MigrationDone(a)) ==> false.  (* Q5_old_key_invalid: 5. after a completed migration, the old key cannot produce an accepted presentation *)

let Issuer(skI: bitstring) =
  in(enroll, subj: bitstring);
  new u: bitstring;
  let said = h((pk(skI), schema, subj, u)) in
  event Issued(said, subj);
  out(deliver, said);
  out(c, (cred, said, subj, sign((said, subj), skI))).

let CheckPresentation(pkI: bitstring, sn: bitstring) =
  in(c, (=cred, said: bitstring, subj: bitstring, isig: bitstring));
  if verify(isig, (said, subj), pkI) = true then
  new n: bitstring; out(c, n);
  in(c, sg: bitstring);
  (* device-bound credential: the subject IS the device public key *)
  if verify(sg, (pres, n, said), subj) = true then event AcceptControl(subj, n, said, subj).
let CheckPresentation1(pkI: bitstring, sn: bitstring) =
  in(c, (=cred, said: bitstring, subj: bitstring, isig: bitstring));
  if verify(isig, (said, subj), pkI) = true then
  new n: bitstring; out(c, n);
  in(c, sg: bitstring);
  (* device-bound credential: the subject IS the device public key *)
  if verify(sg, (pres, n, said), subj) = true then event AcceptCurrent(subj, n, said, subj).

(* Old device: credential is bound to its public key pk(sk0). *)
let OldDevice =
  new sk0: bitstring;
  event KeyGen(sk0, pk(sk0));
  event OldKey(pk(sk0), pk(sk0));
  out(enroll, pk(sk0));
  in(deliver, said: bitstring);
  ( !( in(c, n: bitstring); event DeviceSigned(pk(sk0), n, said, pk(sk0));
       out(c, sign((pres, n, said), sk0)) )
  | out(handover, (pk(sk0), said)) ).

(* New device: a fresh key; without reissuance it can only present the old
   credential, which is bound to the old key. *)
let NewDevice =
  new sk1: bitstring;
  event KeyGen(sk1, pk(sk1));
  ( ( in(handover, (subj: bitstring, said: bitstring));
    event NewKey(subj, pk(sk1));
    event MigrationDone(subj);
    phase 1;
    !( in(c, n: bitstring); event DeviceSigned(subj, n, said, pk(sk1));
       out(c, sign((pres, n, said), sk1)) ) ) ).

process
  new skI: bitstring;
  out(c, pk(skI));
  ( Issuer(skI) | OldDevice | NewDevice
  | !CheckPresentation(pk(skI), s0)
  | (phase 1; !CheckPresentation1(pk(skI), s1))
  )
